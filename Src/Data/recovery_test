

import csv
import math
import sys
from pathlib import Path

import requests

PROJECT_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(PROJECT_ROOT))

from Src.Data.okx_client import (
    BASE_URL,
    MARKET_INSTRUMENTS,
    TIMEFRAME_MAPPING,
    parse_candles
)


ARCHIVE_FILE = (
    PROJECT_ROOT
    / "Data"
    / "Archive"
    / "BTC_USDT_SPOT_5m.csv"
)

INTERVAL_MS = 5 * 60 * 1000
TEST_CANDLE_COUNT = 5


def load_archive():
    if not ARCHIVE_FILE.exists():
        raise RuntimeError("Archive file not found.")

    records = {}

    with ARCHIVE_FILE.open(
        "r",
        newline="",
        encoding="utf-8"
    ) as file:
        reader = csv.DictReader(file)

        for row in reader:
            timestamp = int(row["timestamp"])
            records[timestamp] = row

    return records


def fetch_test_range(start_timestamp, end_timestamp):
    params = {
        "instId": MARKET_INSTRUMENTS["SPOT"],
        "bar": TIMEFRAME_MAPPING["5m"],
        "before": str(start_timestamp - 1),
        "after": str(end_timestamp + 1),
        "limit": "20"
    }

    response = requests.get(
        f"{BASE_URL}/api/v5/market/history-candles",
        params=params,
        timeout=30
    )

    response.raise_for_status()

    result = response.json()

    if result.get("code") != "0":
        raise RuntimeError(
            f"OKX API error: {result.get('msg')}"
        )

    candles = parse_candles(
        result.get("data", []),
        "SPOT",
        "5m"
    )

    return sorted(
        [
            candle
            for candle in candles
            if start_timestamp
            <= candle["timestamp"]
            <= end_timestamp
        ],
        key=lambda candle: candle["timestamp"]
    )


def main():
    print("HISTORICAL RECOVERY TEST")
    print("========================")
    print("Provider: OKX")
    print("Market: SPOT")
    print("Symbol: BTC-USDT")
    print("Timeframe: 5m")
    print("Archive Modification: DISABLED")

    archive = load_archive()
    timestamps = sorted(archive.keys())

    if len(timestamps) < TEST_CANDLE_COUNT:
        raise RuntimeError("Not enough archived candles.")

    middle = len(timestamps) // 2

    selected = timestamps[
        middle:middle + TEST_CANDLE_COUNT
    ]

    if len(selected) != TEST_CANDLE_COUNT:
        raise RuntimeError("Could not select test candles.")

    for index in range(1, len(selected)):
        if selected[index] - selected[index - 1] != INTERVAL_MS:
            raise RuntimeError(
                "Selected test candles are not consecutive."
            )

    start_timestamp = selected[0]
    end_timestamp = selected[-1]

    print(f"\nTest Start UTC: {start_timestamp}")
    print(f"Test End UTC: {end_timestamp}")
    print(f"Expected Candles: {TEST_CANDLE_COUNT}")

    recovered = fetch_test_range(
        start_timestamp,
        end_timestamp
    )

    recovered_map = {
        candle["timestamp"]: candle
        for candle in recovered
    }

    missing_from_api = [
        timestamp
        for timestamp in selected
        if timestamp not in recovered_map
    ]

    mismatches = []

    fields = [
        "open",
        "high",
        "low",
        "close",
        "volume"
    ]

    for timestamp in selected:
        if timestamp not in recovered_map:
            continue

        archived_row = archive[timestamp]
        api_row = recovered_map[timestamp]

        for field in fields:
            archived_value = float(archived_row[field])
            api_value = float(api_row[field])

            if not math.isclose(
                archived_value,
                api_value,
                rel_tol=1e-12,
                abs_tol=1e-12
            ):
                mismatches.append({
                    "timestamp": timestamp,
                    "field": field,
                    "archive": archived_value,
                    "api": api_value
                })

    print("\nRECOVERY TEST RESULTS")
    print("=====================")
    print(f"API Candles Retrieved: {len(recovered)}")
    print(f"Missing From API: {len(missing_from_api)}")
    print(f"OHLCV Mismatches: {len(mismatches)}")

    if missing_from_api:
        print(f"Missing Timestamps: {missing_from_api}")

    if mismatches:
        print(f"Mismatch Details: {mismatches[:5]}")

    if (
        len(recovered_map) == TEST_CANDLE_COUNT
        and not missing_from_api
        and not mismatches
    ):
        print("RECOVERY TEST STATUS: PASS")
    else:
        raise RuntimeError(
            "Historical recovery test failed."
        )

    print("ARCHIVE MODIFIED: NO")


if __name__ == "__main__":
    main()
